<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WaterSystem.Mobile.DashboardPage"
    BackgroundColor="#F3F7FA"
    NavigationPage.HasNavigationBar="False"
    Title="Dashboard">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="22">

                <!-- Header -->
                <Grid
                    Padding="25,35,25,30"
                    BackgroundColor="#123B59"
                    ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Spacing="6"
                        VerticalOptions="Center">

                        <Image
                            Source="watersystem_logo.png"
                            Aspect="AspectFit"
                            WidthRequest="165"
                            HeightRequest="43"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"/>

                        <Label x:Name="WelcomeLabel" 
                               Text="Hello!" 
                               FontSize="27" 
                               FontAttributes="Bold" 
                               TextColor="White"/>

                        <Label
                            Text="Welcome to your account"
                            FontSize="13"
                            TextColor="#C5D9E8"/>
                    </VerticalStackLayout>

                    <Border
                            Grid.Column="1"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="White"
                            VerticalOptions="Center">

                        <Grid>
                            <Image
                                x:Name="UserAvatarImage"
                                Aspect="AspectFill"
                                IsVisible="False"/>
                            <Label
                                    x:Name="UserAvatarInitialLabel"
                                    Text="U"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#123B59"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <VerticalStackLayout
                    Padding="22,0"
                    Spacing="18">

                    <!-- Consumption Card -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#E1EAF0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="22">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="CURRENT CONSUMPTION"
                                FontSize="12"
                                CharacterSpacing="1"
                                FontAttributes="Bold"
                                TextColor="#718096"/>

                            <HorizontalStackLayout
                                Spacing="6"
                                VerticalOptions="End">

                                <Label
                                    x:Name="ConsumptionLabel"
                                    Text="--"
                                    FontSize="38"
                                    FontAttributes="Bold"
                                    TextColor="#123B59"/>

                                <Label
                                    Text="m³"
                                    FontSize="16"
                                    TextColor="#718096"
                                    VerticalOptions="End"
                                    Margin="0,0,0,7"/>
                            </HorizontalStackLayout>

                            <Label
                                x:Name="ConsumptionPeriodLabel"
                                Text="Loading consumption..."
                                FontSize="13"
                                TextColor="#3987C9"/>

                            <BoxView
                                HeightRequest="6"
                                CornerRadius="3"
                                Color="#E5EEF4"/>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Information Cards -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="14">

                        <Border
                            BackgroundColor="White"
                            Stroke="#E1EAF0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">

                            <VerticalStackLayout Spacing="9">

                                <Label
                                    Text="LAST INVOICE"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#718096"/>

                                <Label
                                    x:Name="InvoicePriceLabel"
                                    Text="--"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="#123B59"/>

                                <Border
                                    BackgroundColor="#DCFCE7"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,4"
                                    HorizontalOptions="Start">

                                    <Label
                                        x:Name="InvoiceStatusLabel"
                                        Text="Loading..."
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#15803D"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E1EAF0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">

                            <VerticalStackLayout Spacing="9">

                                <Label
                                    Text="WATER METER"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#718096"/>

                                <Label
                                    x:Name="MeterStatusLabel"
                                    Text="--"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="#123B59"/>

                                <Label
                                    x:Name="MeterLabel"
                                    Text="Meter #--"
                                    FontSize="12"
                                    TextColor="#718096"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Quick Access -->
                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Quick Access"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#123B59"/>

                        <Border
                            BackgroundColor="White"
                            Stroke="#E1EAF0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Usage_Tapped"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Label
                                    Text="◷"
                                    FontSize="25"
                                    TextColor="#3987C9"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="Consumption History"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#123B59"
                                    VerticalOptions="Center"
                                    Margin="12,0"/>

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="25"
                                    TextColor="#3987C9"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <Border
                            BackgroundColor="White"
                            Stroke="#E1EAF0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Invoices_Tapped"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Label
                                    Text="▤"
                                    FontSize="24"
                                    TextColor="#3987C9"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="My Invoices"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#123B59"
                                    VerticalOptions="Center"
                                    Margin="12,0"/>

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="25"
                                    TextColor="#3987C9"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Label
                    Text="© 2026 WaterSystem"
                    FontSize="11"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"
                    Margin="0,0,0,18"/>

            </VerticalStackLayout>
        </ScrollView>


        <!-- Bottom Navigation -->
        <Grid
            Grid.Row="1"
            BackgroundColor="White"
            Padding="12,12"
            ColumnDefinitions="*,*,*,*">

            <!-- Home -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="⌂"
                    FontSize="24"
                    TextColor="#123B59"
                    HorizontalOptions="Center"/>
                <Label
                    Text="Home"
                    FontSize="10"
                    TextColor="#123B59"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Usage -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Usage_Tapped"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="◷"
                    FontSize="24"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
                <Label
                    Text="Usage"
                    FontSize="10"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Invoices -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="4">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Invoices_Tapped"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="▤"
                    FontSize="24"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
                <Label
                    Text="Invoices"
                    FontSize="10"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Profile -->
            <VerticalStackLayout
                 Grid.Column="3"
                 Spacing="4">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Profile_Tapped"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="○"
                    FontSize="24"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
                <Label
                    Text="Profile"
                    FontSize="10"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
