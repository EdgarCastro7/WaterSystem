<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WaterSystem.Mobile.MainPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#082B45">

    <ScrollView VerticalOptions="Fill">
        <Grid
    Padding="24,45"
    MinimumHeightRequest="700">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#071F35" Offset="0.0"/>
                    <GradientStop Color="#123B59" Offset="0.55"/>
                    <GradientStop Color="#17658A" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Decorative water shapes -->
            <Ellipse
                WidthRequest="250"
                HeightRequest="250"
                Fill="#267BA0"
                Opacity="0.12"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                TranslationX="-130"
                TranslationY="-120"/>

            <Ellipse
                WidthRequest="220"
                HeightRequest="220"
                Fill="#65C8E8"
                Opacity="0.10"
                HorizontalOptions="End"
                VerticalOptions="End"
                TranslationX="120"
                TranslationY="100"/>

            <VerticalStackLayout
                Spacing="28"
                MaximumWidthRequest="450"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <!-- Brand -->
                <VerticalStackLayout
                    Spacing="16"
                    HorizontalOptions="Center">

                    <Image
                        Source="watersystem_logo.png"
                        Aspect="AspectFit"
                        WidthRequest="240"
                        HeightRequest="85"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                    <Label
                        Text="Water management made simple."
                        FontSize="14"
                        TextColor="#C5D9E8"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Login Card -->
                <Border
                    BackgroundColor="#FFFFFF"
                    Stroke="#FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26"
                    Padding="28">

                    <VerticalStackLayout Spacing="21">

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Welcome back!"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#123B59"/>

                            <Label
                                Text="Sign in to manage your water account."
                                FontSize="13"
                                TextColor="#718096"/>
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="Email Address"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#234B68"/>

                            <Border
                                BackgroundColor="#F2F6F9"
                                Stroke="#E1EAF0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,0">

                                <Entry
                                    x:Name="EmailEntry"
                                    Placeholder="Enter your email"
                                    Keyboard="Email"
                                    TextColor="#123B59"
                                    PlaceholderColor="#94A3B8"
                                    BackgroundColor="Transparent"
                                    HeightRequest="52"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="Password"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#234B68"/>

                            <Border
                                BackgroundColor="#F2F6F9"
                                Stroke="#E1EAF0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,0">

                                <Entry
                                    x:Name="PasswordEntry"
                                    Placeholder="Enter your password"
                                    IsPassword="True"
                                    TextColor="#123B59"
                                    PlaceholderColor="#94A3B8"
                                    BackgroundColor="Transparent"
                                    HeightRequest="52"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Sign In -->
                        <Button
                            x:Name="LoginButton"
                            Text="Sign In"
                            Clicked="LoginButton_Clicked"
                            BackgroundColor="#123B59"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="13"
                            HeightRequest="54"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Footer -->
                <Label
                    Text="© 2026 WaterSystem. All rights reserved."
                    FontSize="11"
                    TextColor="#B5CDDE"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
