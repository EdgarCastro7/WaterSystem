<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WaterSystem.Mobile.InvoiceDetailsPage"
    BackgroundColor="#F3F7FA"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="22">

            <!-- Header -->
            <Grid
                Padding="25,35,25,30"
                BackgroundColor="#123B59"
                ColumnDefinitions="Auto,*">

                <Label
                    Text="‹"
                    FontSize="35"
                    TextColor="White"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Back_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="6"
                    VerticalOptions="Center"
                    Margin="12,0,0,0">

                    <Label
                        Text="WATERSYSTEM"
                        FontSize="12"
                        CharacterSpacing="2"
                        TextColor="#B9D7E8"/>

                    <Label
                        Text="Invoice Details"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <Label
                        x:Name="InvoiceNumberLabel"
                        FontSize="13"
                        TextColor="#C5D9E8"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout
                Padding="22,0"
                Spacing="18">

                <!-- Invoice information -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E1EAF0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="INVOICE INFORMATION"
                            FontSize="12"
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            TextColor="#718096"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Issue date" TextColor="#718096"/>
                            <Label
                                x:Name="InvoiceDateLabel"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                TextColor="#123B59"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Meter" TextColor="#718096"/>
                            <Label
                                x:Name="MeterLabel"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                TextColor="#123B59"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Payment status" TextColor="#718096"/>
                            <Label
                                x:Name="PaymentStatusLabel"
                                Grid.Column="1"
                                FontAttributes="Bold"/>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#E1EAF0"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Total amount"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#123B59"/>

                            <Label
                                x:Name="PriceLabel"
                                Grid.Column="1"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#1769AA"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Consumption information -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E1EAF0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="ASSOCIATED CONSUMPTION"
                            FontSize="12"
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            TextColor="#718096"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Consumption ID" TextColor="#718096"/>
                            <Label
                                x:Name="ConsumptionIdLabel"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                TextColor="#123B59"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Reading date" TextColor="#718096"/>
                            <Label
                                x:Name="ConsumptionDateLabel"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                TextColor="#123B59"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Volume" TextColor="#718096"/>
                            <Label
                                x:Name="ConsumptionVolumeLabel"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                TextColor="#123B59"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <Label
                Text="© 2026 WaterSystem"
                FontSize="11"
                TextColor="#94A3B8"
                HorizontalOptions="Center"
                Margin="0,0,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
