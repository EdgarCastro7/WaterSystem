<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WaterSystem.Mobile.UsagePage"
    BackgroundColor="#F3F7FA"
    NavigationPage.HasNavigationBar="False"
    Title="Usage">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="22">

                <!-- Header -->
                <Grid
                    Padding="25,35,25,30"
                    BackgroundColor="#123B59"
                    ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Spacing="6"
                        VerticalOptions="Center">

                        <Label
                            Text="WATERSYSTEM"
                            FontSize="12"
                            CharacterSpacing="2"
                            TextColor="#B9D7E8"/>

                        <Label
                            Text="Usage"
                            FontSize="27"
                            FontAttributes="Bold"
                            TextColor="White"/>

                        <Label
                            Text="Track your water consumption"
                            FontSize="13"
                            TextColor="#C5D9E8"/>
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#E5EEF4"
                        VerticalOptions="Center">

                        <Grid>
                            <Image
                                x:Name="UserAvatarImage"
                                Aspect="AspectFill"
                                IsVisible="False"/>

                            <Label
                                x:Name="UserAvatarInitialLabel"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#123B59"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <VerticalStackLayout
                    Padding="22,0"
                    Spacing="18">

                    <!-- Current Consumption -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#E1EAF0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="20">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="CURRENT CONSUMPTION"
                                FontSize="12"
                                CharacterSpacing="1"
                                FontAttributes="Bold"
                                TextColor="#718096"/>

                            <HorizontalStackLayout
                                Spacing="6"
                                VerticalOptions="Center">

                                <Label
                                    x:Name="CurrentConsumptionLabel"
                                    Text="--"
                                    FontSize="36"
                                    FontAttributes="Bold"
                                    TextColor="#3987C9"/>

                                <Label
                                    Text="m³"
                                    FontSize="17"
                                    TextColor="#718096"
                                    VerticalOptions="End"/>
                            </HorizontalStackLayout>

                            <BoxView
                                HeightRequest="1"
                                Color="#E5EEF4"/>

                            <Label
                                x:Name="ConsumptionPeriodLabel"
                                Text="Loading consumption period..."
                                FontSize="13"
                                TextColor="#718096"/>

                            <Label
                                x:Name="CurrentMeterLabel"
                                Text="Meter: --"
                                FontSize="13"
                                TextColor="#123B59"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Consumption History -->
                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="CONSUMPTION HISTORY"
                            FontSize="12"
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            TextColor="#718096"/>

                        <VerticalStackLayout
                            x:Name="HistoryList"
                            Spacing="10">

                            <Label
                                Text="Loading consumption history..."
                                FontSize="13"
                                TextColor="#718096"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Label
                    Text="© 2026 WaterSystem"
                    FontSize="11"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"
                    Margin="0,0,0,18"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid
            Grid.Row="1"
            BackgroundColor="White"
            Padding="12,12"
            ColumnDefinitions="*,*,*,*">

            <!-- Home -->
            <VerticalStackLayout Spacing="4">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Home_Tapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label
                    Text="⌂"
                    FontSize="24"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Home"
                    FontSize="10"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Usage -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4">

                <Label
                    Text="◷"
                    FontSize="24"
                    TextColor="#123B59"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Usage"
                    FontSize="10"
                    TextColor="#123B59"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Invoices -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="4">

                <Label
                    Text="▤"
                    FontSize="24"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Invoices"
                    FontSize="10"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Profile -->
            <VerticalStackLayout
                Grid.Column="3"
                Spacing="4">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Profile_Tapped"/>
                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="○"
                    FontSize="24"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Profile"
                    FontSize="10"
                    TextColor="#94A3B8"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>

    </Grid>
</ContentPage>
