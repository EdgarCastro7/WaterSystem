@model IEnumerable<WaterSystem.Data.Entities.User>

@{
    ViewData["Title"] = "Users";
}

<ejs-toast id="userToast"
           timeOut="5000"
           showCloseButton="true"
           showProgressBar="true">
    <e-toast-position X="Right" Y="Bottom"></e-toast-position>
</ejs-toast>

@if (TempData["Error"] != null || TempData["Success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toastElement = document.getElementById("userToast");
            var toast = toastElement.ej2_instances[0];

            var isError = '@(TempData["Error"] != null ? "true" : "false")' === "true";

            var message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            (TempData["Error"] ?? TempData["Success"])?.ToString()));

        toast.show({
            title: isError ? "Error" : "Success",
            content: message,
            cssClass: isError ? "e-toast-danger" : "e-toast-success"
        });
    });
</script>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Users</h1>
    <a asp-action="Create" class="btn btn-primary">Create User</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>
                    @if (user.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info">Details</a>

                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a>

                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
