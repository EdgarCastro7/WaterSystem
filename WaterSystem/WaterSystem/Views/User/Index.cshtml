@model IEnumerable<WaterSystem.Data.Entities.User>

@{
    ViewData["Title"] = "Users";
}

<ejs-toast id="userToast"
           timeOut="5000"
           showCloseButton="true"
           showProgressBar="true">
    <e-toast-position X="Right" Y="Bottom"></e-toast-position>
</ejs-toast>

@if (TempData["Error"] != null || TempData["Success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toastElement = document.getElementById("userToast");
            var toast = toastElement.ej2_instances[0];

            var isError = '@(TempData["Error"] != null ? "true" : "false")' === "true";

            var message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            (TempData["Error"] ?? TempData["Success"])?.ToString()));

        toast.show({
            title: isError ? "Error" : "Success",
            content: message,
            cssClass: isError ? "e-toast-danger" : "e-toast-success"
        });
    });
</script>
}

<div class="ws-page-container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="ws-page-header ws-page-header-left mb-0">
            <h1>Users</h1>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> Create User
        </a>
    </div>

    <div class="ws-page-card p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FirstName</td>
                                <td>@user.LastName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a asp-action="Details" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye me-1"></i> Details
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                No users found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>