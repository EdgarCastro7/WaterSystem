@model WaterSystem.Data.Entities.User

@{
    ViewData["Title"] = "Delete User";
}

<h1>Delete User</h1>

<h3>Are you sure you want to delete this user?</h3>

<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">
                First Name
            </dt>
            <dd class="col-sm-8">
                @Model.FirstName
            </dd>

            <dt class="col-sm-4">
                Last Name
            </dt>
            <dd class="col-sm-8">
                @Model.LastName
            </dd>

            <dt class="col-sm-4">
                Email
            </dt>
            <dd class="col-sm-8">
                @Model.Email
            </dd>

            <dt class="col-sm-4">
                Address
            </dt>
            <dd class="col-sm-8">
                @Model.Address
            </dd>

            <dt class="col-sm-4">
                Phone Number
            </dt>
            <dd class="col-sm-8">
                @Model.PhoneNumber
            </dd>
        </dl>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>
