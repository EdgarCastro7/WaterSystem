@model IEnumerable<WaterSystem.Data.Entities.Meter>

@{
    ViewData["Title"] = "Meters";
}

<div class="ws-page-container">

    <div class="ws-page-header ws-page-header-left">
        <h1>Meters</h1>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-3">

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Create Meter
            </a>
        }

        @if (User.IsInRole("Client"))
        {
            <a asp-action="RequestAdditional" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Add Meter
            </a>
        }

    </div>

    <div class="ws-page-card p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Installation Date</th>
                        <th>Status</th>
                        <th>Client</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var meter in Model)
                    {
                        <tr>
                            <td>@meter.InstallationDate.ToString("dd/MM/yyyy")</td>

                            <td>
                                @if (meter.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>

                            <td>@meter.User?.FullName</td>

                            <td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@meter.Id"
                                       class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
