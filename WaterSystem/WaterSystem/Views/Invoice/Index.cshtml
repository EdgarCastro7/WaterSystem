@model IEnumerable<WaterSystem.Data.Entities.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<ejs-toast id="invoiceToast"
           timeOut="5000"
           showCloseButton="true"
           showProgressBar="true">
    <e-toast-position X="Right" Y="Bottom"></e-toast-position>
</ejs-toast>

@if (TempData["ToastMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toastElement = document.getElementById("invoiceToast");
            var toast = toastElement.ej2_instances[0];

            var toastType = '@(TempData["ToastType"] ?? "Success")';
            var toastMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"]?.ToString()));

            toast.show({
                title: toastType,
                content: toastMessage,
                cssClass: "e-toast-" + toastType.toLowerCase()
            });
        });
    </script>
}

<div class="ws-page-container ws-invoice-container">

    <div class="ws-page-header ws-page-header-left">
        <h1>Invoices</h1>
        <p class="text-muted mb-0">Manage and review water consumption invoices.</p>
    </div>

    <div class="ws-page-card p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 ws-invoice-table">
                <thead>
                    <tr>
                        <th>Invoice Date</th>
                        <th>Client</th>
                        <th>Meter</th>
                        <th>Consumption ID</th>
                        <th>Price</th>
                        <th>Payment Status</th>
                        <th>Approval Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@invoice.DateTime.ToString("dd/MM/yyyy")</td>
                                <td class="ws-invoice-client">@invoice.User?.Email</td>
                                <td>@invoice.MeterId</td>
                                <td>@invoice.ConsumptionId</td>
                                <td class="text-nowrap fw-semibold">@invoice.Price.ToString("C")</td>

                                <td>
                                    @if (invoice.Status == "Rejected")
                                    {
                                        <span class="badge bg-secondary">N/A</span>
                                    }
                                    else if (invoice.Payment)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>

                                <td>
                                    @if (invoice.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Awaiting approval</span>
                                    }
                                    else if (invoice.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (invoice.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>

                                <td>
                                    <div class="ws-invoice-actions">

                                        @if (User.IsInRole("Employee") && invoice.Status == "Rejected")
                                        {
                                            <a asp-action="Correct"
                                               asp-route-id="@invoice.Id"
                                               class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil-square me-1"></i> Correct
                                            </a>
                                        }

                                        @if (User.IsInRole("Employee") && invoice.Status == "Pending")
                                        {
                                            <form asp-action="Approve"
                                                  asp-route-id="@invoice.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-check-circle me-1"></i> Approve
                                                </button>
                                            </form>

                                            <form asp-action="Reject"
                                                  asp-route-id="@invoice.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-x-circle me-1"></i> Reject
                                                </button>
                                            </form>
                                        }

                                        @if (User.IsInRole("Client") && invoice.Status == "Approved")
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@invoice.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-eye me-1"></i> View Invoice
                                            </a>

                                            @if (!invoice.Payment)
                                            {
                                                <form asp-action="Pay"
                                                      asp-route-id="@invoice.Id"
                                                      method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-primary btn-sm">
                                                        <i class="bi bi-credit-card me-1"></i> Pay
                                                    </button>
                                                </form>
                                            }
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                No invoices found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    .ws-invoice-container {
        max-width: 1450px;
    }

    .ws-invoice-table {
        min-width: 1150px;
    }

        .ws-invoice-table th,
        .ws-invoice-table td {
            padding: 18px 20px;
            vertical-align: middle;
        }

        .ws-invoice-table thead th {
            white-space: nowrap;
        }

    .ws-invoice-client {
        min-width: 190px;
    }

    .ws-invoice-actions {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 8px;
        min-width: 190px;
    }

        .ws-invoice-actions form {
            display: inline-flex;
            margin: 0;
        }

        .ws-invoice-actions .btn {
            white-space: nowrap;
        }

    @@media (max-width: 768px) {
        .ws-invoice-table th,
        .ws-invoice-table td {
            padding: 14px 16px;
        }
    }
</style>
