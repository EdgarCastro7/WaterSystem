@model WaterSystem.Models.CorrectInvoiceViewModel

@{
    ViewData["Title"] = "Correct Invoice";
}

<div class="ws-page-container">

    <div class="ws-page-header">
        <h1>Correct Invoice</h1>
    </div>

    <div class="ws-page-card">
        <form asp-action="Correct" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="OriginalInvoiceId" />

            <div class="form-group mb-4">
                <label asp-for="NewPrice" class="control-label">New Invoice Value (€)</label>

                <input asp-for="NewPrice" class="form-control" type="number" step="0.01" min="0.01"
                       placeholder="Enter the new invoice value..." />

                <span asp-validation-for="NewPrice" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i> Submit Correction
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
