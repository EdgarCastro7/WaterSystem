@model WaterSystem.Models.CorrectInvoiceViewModel

@{
    ViewData["Title"] = "Correct Invoice";
}

<div class="ws-page-container">

    <div class="ws-page-header">
        <h1>Correct Invoice</h1>
        <p class="text-muted">The invoice value will be recalculated automatically.</p>
    </div>

    <div class="ws-page-card ws-page-card-narrow">

        <form asp-action="Correct" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="OriginalInvoiceId" />

            <div class="mb-4">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-calculator fs-3" style="color:#123B59;"></i>
                    <div>
                        <h5>Automatic Price Calculation</h5>
                        <p class="text-muted mb-0">
                            The system will recalculate the invoice amount based on the approved consumption readings and the price tiers configured by the administrator.
                        </p>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat me-1"></i> Recalculate Invoice
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

        </form>
    </div>

</div>