@model WaterSystem.Models.ConsumptionViewModel

@{
    ViewData["Title"] = "Edit Consumption";
}

<div class="ws-page-container">
    <div class="ws-page-header">
        <h1>Edit Consumption</h1>
    </div>

    <div class="ws-page-card ws-page-card-narrow">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MeterId" />

            <div class="mb-3">
                <label asp-for="Date" class="form-label">Reading Date</label>
                <ejs-datepicker id="Date"
                                ejs-for="Date"
                                format="dd/MM/yyyy"
                                placeholder="Select reading date">
                </ejs-datepicker>
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Volume" class="form-label">Meter Reading (m³)</label>
                <input asp-for="Volume" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Volume" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i> Save
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
