@model WaterSystem.Data.Entities.Consumption

@{
    ViewData["Title"] = "Delete Consumption";
}

<div class="ws-page-container">
    <div class="ws-page-header">
        <h1>Delete Consumption</h1>
    </div>

    <div class="ws-page-card ws-page-card-narrow">
        <h5 class="mb-4">Are you sure you want to delete this consumption?</h5>

        <dl class="row mb-4">
            <dt class="col-sm-5">Meter</dt>
            <dd class="col-sm-7">@Model.MeterId</dd>

            <dt class="col-sm-5">Reading Date</dt>
            <dd class="col-sm-7">@Model.Date.ToShortDateString()</dd>

            <dt class="col-sm-5">Meter Reading (m³)</dt>
            <dd class="col-sm-7">@Model.Volume</dd>
        </dl>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>
