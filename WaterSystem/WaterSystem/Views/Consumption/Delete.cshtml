@model WaterSystem.Data.Entities.Consumption

@{
    ViewData["Title"] = "Delete Consumption";
}

<h1>Delete Consumption</h1>

<h3>Are you sure you want to delete this consumption?</h3>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Meter</dt>
        <dd class="col-sm-9">@Model.MeterId</dd>

        <dt class="col-sm-3">Reading Date</dt>
        <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>

        <dt class="col-sm-3">Meter Reading (m³)</dt>
        <dd class="col-sm-9">@Model.Volume</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

