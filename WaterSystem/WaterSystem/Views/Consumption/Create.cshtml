@model WaterSystem.Models.ConsumptionViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using WaterSystem.Data.Entities

@{
    ViewData["Title"] = "Create Consumption";
    var meters = ViewBag.Meters as IEnumerable<Meter>;
}

<h1>Create Consumption</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="MeterId" class="control-label">Meter</label>
                <select asp-for="MeterId"
                        class="form-control"
                        asp-items="@(new SelectList(meters, "Id", "Id"))">
                    <option value="">-- Select Meter --</option>
                </select>
                <span asp-validation-for="MeterId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Date" class="control-label">Reading Date</label>
                <input asp-for="Date" type="date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Volume" class="control-label">Meter Reading (m³)</label>
                <input asp-for="Volume" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Volume" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}