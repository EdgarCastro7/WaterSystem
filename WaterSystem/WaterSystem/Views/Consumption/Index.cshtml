@model IEnumerable<WaterSystem.Data.Entities.Consumption>

@{
    ViewData["Title"] = "Consumptions";
}

<h1>Consumptions</h1>

@if (User.IsInRole("Employee") || User.IsInRole("Client"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create Consumption</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Meter</th>
            <th>Reading Date</th>
            <th>Meter Reading (m³)</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var consumption in Model)
        {
            <tr>
                <td>@consumption.MeterId</td>
                <td>@consumption.Date.ToShortDateString()</td>
                <td>@consumption.Volume</td>
                <td>
                    @if (consumption.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (consumption.Status == "Approved")
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else if (consumption.Status == "Rejected")
                    {
                        <span class="badge bg-danger">Rejected</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Employee"))
                    {
                        @if (consumption.Status == "Pending" || consumption.Status == "Rejected")
                        {
                            <a asp-action="Edit"
                               asp-route-id="@consumption.Id"
                               class="btn btn-warning btn-sm">Edit</a>

                            <a asp-action="Delete"
                               asp-route-id="@consumption.Id"
                               class="btn btn-danger btn-sm">Delete</a>
                        }

                        @if (consumption.Status == "Pending")
                        {
                            <form asp-action="Approve"
                                  asp-route-id="@consumption.Id"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm">
                                    Approve
                                </button>
                            </form>

                            <form asp-action="Reject"
                                  asp-route-id="@consumption.Id"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    Reject
                                </button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>