@model WaterSystem.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Define Password";
}

<div class="ws-page-container">
    <div class="ws-page-header">
        <h1>Define Password</h1>
    </div>

    <div class="ws-page-card ws-page-card-narrow">
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-key me-1"></i> Define Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
