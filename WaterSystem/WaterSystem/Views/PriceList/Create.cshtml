@model WaterSystem.Data.Entities.PriceList

@{
    ViewData["Title"] = "Create Price Tier";
}

<div class="ws-page-container">
    <div class="ws-page-header">
        <h1>Create Price Tier</h1>
    </div>

    <div class="ws-page-card ws-page-card-narrow">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="MaxVolume" class="form-label">
                    Maximum Volume (m³)
                </label>
                <input asp-for="MaxVolume" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="MaxVolume" class="text-danger"></span>
                <small class="form-text text-muted">
                    Leave empty for an unlimited tier.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="PricePerM3" class="form-label">
                    Price per m³ (€)
                </label>
                <input asp-for="PricePerM3" class="form-control" type="number" step="0.01" required />
                <span asp-validation-for="PricePerM3" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Create
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
