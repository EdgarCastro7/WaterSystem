@model IEnumerable<WaterSystem.Data.Entities.PriceList>

@{
    ViewData["Title"] = "Price Lists";
}

<div class="ws-page-container">
    <div class="ws-page-header ws-page-header-left">
        <h1>Price Lists</h1>
    </div>

    <div class="ws-page-card p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Maximum Volume (m³)</th>
                        <th>Price per m³</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var priceList in Model)
                        {
                            <tr>
                                <td>
                                    @(priceList.MaxVolume.HasValue
                                                                ? priceList.MaxVolume.Value.ToString("N2")
                                                                : "Unlimited")
                        </td>
                        <td>@priceList.PricePerM3.ToString("C")</td>
                    </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center py-4">
                                No price tiers configured.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
