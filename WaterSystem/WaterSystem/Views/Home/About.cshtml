@{
    ViewData["Title"] = "About Us";
}

<section class="ws-about-hero">
    <div class="ws-about-hero-overlay"></div>

    <div class="ws-about-hero-content">
        <span class="ws-hero-label">ABOUT WATERSYSTEM</span>

        <h1>
            Managing water.<br />
            <span>Building a better future.</span>
        </h1>

        <p>
            Discover how WaterSystem makes water management
            simpler, smarter and more transparent.
        </p>
    </div>
</section>


<section class="ws-about-mission">
    <div class="ws-about-mission-container">

        <div class="ws-about-mission-image">
            <img src="~/images/water-hero.png" alt="Water management and clean water" />
        </div>

        <div class="ws-about-mission-content">
            <span class="ws-section-label">OUR MISSION</span>

            <h2>Making water management simpler and smarter.</h2>

            <p>
                At WaterSystem, our mission is to simplify the way
                water consumption is managed and monitored.
            </p>

            <p>
                We bring together technology, transparency and
                efficiency to provide a reliable experience for
                clients and employees.
            </p>
        </div>

    </div>
</section>



<section class="ws-how-we-work">
    <div class="ws-how-container">

        <div class="ws-how-heading">
            <span class="ws-section-label">HOW WE WORK</span>
            <h2>A simple process. Smarter management.</h2>
            <p>Discover how WaterSystem brings every step of water management together.</p>
        </div>

        <div class="ws-how-steps">

            <div class="ws-how-step">
                <div class="ws-how-number">01</div>
                <div class="ws-how-icon">
                    <i class="bi bi-speedometer2"></i>
                </div>
                <h3>Meter Installation</h3>
                <p>
                    Request a water meter and let our team manage
                    the installation process.
                </p>
            </div>

            <div class="ws-how-step">
                <div class="ws-how-number">02</div>
                <div class="ws-how-icon">
                    <i class="bi bi-droplet"></i>
                </div>
                <h3>Consumption Management</h3>
                <p>
                    Submit readings and keep track of your
                    water consumption over time.
                </p>
            </div>

            <div class="ws-how-step">
                <div class="ws-how-number">03</div>
                <div class="ws-how-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <h3>Invoice Management</h3>
                <p>
                    Access your invoices, review charges
                    and manage your payments.
                </p>
            </div>

        </div>
    </div>
</section>



<section class="ws-vision">
    <div class="ws-vision-container">

        <div class="ws-vision-intro">
            <span class="ws-section-label">OUR VISION</span>
            <h2>Building a smarter approach to water management.</h2>
            <p>
                We believe that technology and accessible information
                can make water management more efficient, transparent
                and responsible.
            </p>
        </div>

        <div class="ws-values">
            <div class="ws-value">
                <i class="bi bi-lightning-charge"></i>
                <div>
                    <h3>Efficiency</h3>
                    <p>Simplifying processes through digital solutions and better management.</p>
                </div>
            </div>

            <div class="ws-value">
                <i class="bi bi-shield-check"></i>
                <div>
                    <h3>Transparency</h3>
                    <p>Providing clear and accessible information about water consumption and billing.</p>
                </div>
            </div>

            <div class="ws-value">
                <i class="bi bi-recycle"></i>
                <div>
                    <h3>Responsibility</h3>
                    <p>Encouraging conscious water consumption and responsible resource management.</p>
                </div>
            </div>
        </div>

    </div>
</section>


<section class="ws-commitment">
    <div class="ws-commitment-overlay"></div>

    <div class="ws-commitment-content">
        <span>OUR COMMITMENT</span>

        <h2>Every drop matters.<br />Every action counts.</h2>

        <p>
            We are committed to making water management
            more efficient, transparent and accessible.
        </p>

        <a asp-controller="Account" asp-action="Login" class="btn ws-commitment-btn">
            Explore Your Client Area
            <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
</section>
