@using Microsoft.AspNetCore.Identity
@using WaterSystem.Data.Entities
@inject UserManager<User> UserManager

@{
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
} 

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - WaterSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WaterSystem.styles.css" asp-append-version="true" />

    <link href="https://cdn.syncfusion.com/ej2/35.1.43/fluent.css" rel="stylesheet" />
</head>

<body class="ws-body">


    <header>
        <nav class="navbar navbar-expand-lg ws-navbar">
            <div class="container">

                <a class="navbar-brand ws-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="ws-brand-icon">
                        <i class="bi bi-droplet-fill"></i>
                    </span>
                    WaterSystem
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-4 me-auto">

                        <li class="nav-item">
                            <a class="nav-link ws-nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Users </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="Meter" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Meters </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="PriceList" asp-action="Index">
                                    <i class="bi bi-tags me-1"></i> Prices </a>
                            </li>
                        }

                        @if (User.IsInRole("Employee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="Meter" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Meters </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="Consumption" asp-action="Index">
                                    <i class="bi bi-droplet me-1"></i> Consumptions </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="Invoice" asp-action="Index">
                                    <i class="bi bi-receipt me-1"></i> Invoices </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="MeterRequest" asp-action="Index">
                                    <i class="bi bi-clipboard-check me-1"></i> Requests </a>
                            </li>
                        }

                        @if (User.IsInRole("Client"))
                        {
                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="Meter" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Meters </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="Consumption" asp-action="Index">
                                    <i class="bi bi-droplet me-1"></i> Consumptions </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="Invoice" asp-action="Index">
                                    <i class="bi bi-receipt me-1"></i> Invoices </a>
                            </li>
                        }

                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link ws-nav-link" asp-controller="MeterRequest" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i> Request Meter </a>
                            </li>
                        }

                    </ul>

                    <div class="dropdown ws-profile-dropdown">

                        @if (currentUser != null)
                        {
                            <button class="btn ws-profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">

                                @if (!string.IsNullOrEmpty(currentUser.ImageUrl))
                                {
                                    <img src="@currentUser.ImageUrl" class="ws-avatar" alt="Profile photo" />
                                }
                                else
                                {
                                    <span class="ws-avatar ws-avatar-placeholder">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                }

                                <span class="ws-profile-name">
                                    @currentUser.FullName
                                </span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end ws-profile-menu">
                                <li>
                                    <span class="dropdown-item-text ws-profile-email">
                                        @currentUser.Email
                                    </span>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangeUser">
                                        <i class="bi bi-person-gear me-2"></i> My Profile </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-lock me-2"></i> Change Password </a>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <a class="dropdown-item ws-logout-link" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Logout </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn ws-btn-login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>


    <div class="ws-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>


    <footer class="ws-footer">
        <div class="ws-footer-main">
            <div class="ws-footer-container">

                <div class="ws-footer-brand">
                    <a asp-controller="Home" asp-action="Index" class="ws-footer-logo">
                        <i class="bi bi-droplet-fill"></i>
                        WaterSystem
                    </a>
                    <p>
                        Smart solutions for efficient water management,
                        consumption monitoring and billing.
                    </p>
                </div>

                <div class="ws-footer-column">
                    <h4>Quick Links</h4>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Home" asp-action="About">About Us</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                </div>

                <div class="ws-footer-column">
                    <h4>Our Services</h4>
                    <a asp-controller="Meter" asp-action="Index">Meter Management</a>
                    <a asp-controller="Consumption" asp-action="Index">Consumption Monitoring</a>
                    <a asp-controller="Invoice" asp-action="Index">Online Billing</a>
                </div>

                <div class="ws-footer-column">
                    <h4>Contact Information</h4>
                    <span><i class="bi bi-telephone me-2"></i> +351 210 123 456</span>
                    <span><i class="bi bi-envelope me-2"></i> geral@watersystem.pt</span>
                    <span><i class="bi bi-geo-alt me-2"></i> Lisbon, Portugal</span>
                </div>

            </div>
        </div>

        <div class="ws-footer-bottom">
            <div class="ws-footer-container">
                <span>© 2026 WaterSystem. All rights reserved.</span>
                <span>Designed for smarter water management.</span>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.syncfusion.com/ej2/35.1.43/dist/ej2.min.js"></script>
    <ejs-scripts></ejs-scripts>

</body>
</html>
