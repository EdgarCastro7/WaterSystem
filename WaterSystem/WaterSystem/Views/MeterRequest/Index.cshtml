@model IEnumerable<WaterSystem.Data.Entities.MeterRequest>

@{
    ViewData["Title"] = "Meter Installation Requests";
}

<h1>Meter Installation Requests</h1>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Address</th>
            <th>Request Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.FirstName</td>
                    <td>@request.LastName</td>
                    <td>@request.Email</td>
                    <td>@request.Address</td>
                    <td>@request.RequestDate.ToShortDateString()</td>
                    <td>
                        @if (request.Status == "AccountCreated")
                        {
                            <span class="badge bg-success">Created</span>
                        }
                        else if (request.Status == "MeterCreated")
                        {
                            <span class="badge bg-success">Meter Created</span>
                        }
                        else
                        {
                            @request.Status
                        }
                    </td>
                    <td>
                        @if (request.Status == "Pending")
                        {
                            <form asp-action="Approve" asp-route-id="@request.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm"> Approve </button>
                            </form>

                            <form asp-action="Reject" asp-route-id="@request.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm"> Reject </button>
                            </form>
                        }
                        else if (request.Status == "Approved")
                        {
                            @if (request.UserId == null)
                            {
                                <form asp-action="ForwardToAdmin" asp-route-id="@request.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-primary btn-sm">
                                        Forward to Admin
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Meter"
                                      asp-action="CreateFromRequest"
                                      asp-route-id="@request.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-success btn-sm">
                                        Create Additional Meter
                                    </button>
                                </form>
                            }
                        }
                        else if (request.Status == "ForwardedToAdmin")
                        {
                            @if (request.UserId == null)
                            {
                                <a asp-controller="User" asp-action="CreateFromRequest" asp-route-id="@request.Id"
                                class="btn btn-primary btn-sm"> Create Client Account </a>
                            }
                            else
                            {
                                <form asp-controller="Meter" asp-action="CreateFromRequest" asp-route-id="@request.Id"
                                      method="post" class="d-inline"> 
                                      @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-success btn-sm"> Create Additional Meter </button>
                                </form>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Already processed</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    No meter installation requests found.
                </td>
            </tr>
        }
    </tbody>
</table>